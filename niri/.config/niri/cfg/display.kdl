//    mode "2560x1440@359.979" // Set resolution and refresh rate
//    scale 1 // No scaling (use 2 for HiDPI)
//}

output "DP-2" {
    // Left monitor at 144Hz
    mode "1920x1080@144.001"
    position x=0 y=0
    
    hot-corners {
        off
    }
}

output "DP-1" {
    // Main monitor at 180Hz
    mode "1920x1080@179.961"
    position x=1920 y=0
    
    hot-corners {
        off
    }
}
